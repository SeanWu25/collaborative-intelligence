# Copy to .env and fill in the providers you use. Keys are read by src/collab_intel/harness/llm.py.
# claude-* models, and the judges (claude-sonnet-4-6, claude-haiku-4-5)
ANTHROPIC_API_KEY=
# gpt-* models (the GPT-5 mini partner, the GPT-5 third rater)
OPENAI_API_KEY=
# together:<model id> (the open-weight models)
TOGETHER_API_KEY=

# Optional
# stop paid calls once the usage log passes this many USD (default 10; raise it for a full run)
# HARNESS_BUDGET_USD=100
# the default third partner (Qwen3-14B) and any model of your own, on vLLM or any OpenAI-compatible server
# HARNESS_VLLM_ENDPOINTS={"Qwen/Qwen3-14B": "http://localhost:8001/v1", "my-model": "http://localhost:8000/v1"}
# HARNESS_VLLM_API_KEY=   # only if the server needs a key
# Azure AI Foundry deployments
# AZURE_FOUNDRY_KEY=
# AZURE_FOUNDRY_ENDPOINT=
# AZURE_FOUNDRY_MODELS=
